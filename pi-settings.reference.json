{
  "theme": "dark",
  "defaultProvider": "anthropic",
  "defaultModel": "claude-opus-5",
  "defaultThinkingLevel": "high",
  "extensions": [
    "extensions/zsh-footer.ts"
  ],
  "packages": [
    "git:github.com/badlogic/pi-skills",
    "npm:pi-lens",
    "git:github.com/threadsafe-systems/pi-worktree",
    "npm:pi-agent-browser-native",
    "git:github.com/pankajudhas81/pi-claude-auth",
    "npm:pi-bash-live-view",
    "npm:@observal/pi-insights",
    "npm:pi-subagents",
    "git:github.com/threadsafe-systems/pi-repo-html@v0.1.0",
    "npm:@agney/pi-honcho-memory",
    "git:github.com/threadsafe-systems/pi-sdlc@v3.0.0",
    "npm:pi-questions-helper",
    "npm:@narumitw/pi-goal",
    "git:github.com/threadsafe-systems/pi-conveyancing-agent@main"
  ],
  "skills": [
    "~/.pi/agent/git/github.com/badlogic/pi-skills"
  ],
  "enabledModels": [
    "zai/glm-5.2",
    "deepseek/deepseek-v4-pro",
    "deepseek/deepseek-v4-flash",
    "moonshotai/kimi-k2.7-code",
    "anthropic/claude-fable-5",
    "anthropic/claude-sonnet-5",
    "openai-codex/gpt-5.6-luna",
    "openai-codex/gpt-5.6-sol",
    "google/gemini-3.1-pro-preview",
    "google/gemini-3.6-flash",
    "anthropic/claude-opus-5"
  ],
  "hideThinkingBlock": false,
  "warnings": {
    "anthropicExtraUsage": false
  },
  "defaultProjectTrust": "always",
  "transport": "auto",
  "terminal": {
    "showTerminalProgress": true
  }
}
